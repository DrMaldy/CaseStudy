# ─── Datenbank ───
DATABASE_URL="file:./prisma/dev.db"

# ─── Better Auth ───
BETTER_AUTH_SECRET="bitte-mit-openssl-rand-base64-32-ersetzen"
BETTER_AUTH_URL="http://localhost:3000"

# Testpasswort für alle Seed-Nutzer (nur lokaler Prototyp)
SEED_PASSWORD="Partnerhub-Demo-2026"

# ─── KI-Text: mock | openai-compatible ───
AI_PROVIDER="mock"
# OpenAI-kompatibler Endpunkt, z. B. OpenRouter, OpenAI oder lokal (Ollama: http://localhost:11434/v1)
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY=""
# Modell-ID laut Anbieter (Pflicht bei AI_PROVIDER=openai-compatible)
AI_MODEL=""
# Optionale OpenRouter-Header
AI_APP_URL="http://localhost:3000"
AI_APP_NAME="VR Mobilfunk Partnerhub"

# ─── KI-Bild: mock | openai-compatible | off ───
AI_IMAGE_PROVIDER="mock"
# Leer = wie AI_BASE_URL bzw. AI_API_KEY. OpenRouter wird erkannt und über dessen /images-Endpunkt angesprochen.
# OpenAI direkt: https://api.openai.com/v1
AI_IMAGE_BASE_URL=""
AI_IMAGE_API_KEY=""
# z. B. google/gemini-3.1-flash-image (OpenRouter) oder gpt-image-1 (OpenAI)
AI_IMAGE_MODEL=""

# Test des Fehlerpfads im Mock: never | once | always
MOCK_AI_FAIL="never"
